{
  "manifest_version": 3,
  "name": "AI → SI",
  "version": "1.0.0",
  "description": "Strikes through every \"AI\" on the page and puts a red \"SI\" next to it, matching the original casing.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
